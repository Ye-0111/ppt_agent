# Copy to .env at the repository root and set your local credentials.
SERVER_HOST=127.0.0.1
SERVER_PORT=8001

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ppt_agent
DB_USER=root
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Replace with a random value before registering users; keep it stable afterwards.
PASSWORD_SALT=replace-with-a-random-secret
TOKEN_MAX_AGE=2592000

# Required for chatting and PPT creation; use your DashScope API key.
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus

# Optional search/image services; missing keys disable these integrations.
PEXELS_API_KEY=
TAVILY_API_KEY=

USE_MULTI_AGENT=true
AGENT_MODE=workflow
OUTLINE_REVIEW_ENABLED=true

# Optional tracing; disabled by default.
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=multi-agent-ppt-creator
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
